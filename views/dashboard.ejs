<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0a0e1a; color: #e0e0e0; min-height: 100vh; }
        .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
        header { display: flex; justify-content: space-between; align-items: center; padding: 20px 0; border-bottom: 1px solid #1a1f35; margin-bottom: 30px; flex-wrap: wrap; gap: 12px; }
        .logo { display: flex; align-items: center; gap: 12px; }
        .logo .icon { font-size: 32px; }
        .logo h1 { font-size: 24px; background: linear-gradient(135deg, #60a5fa, #a78bfa); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .logo .subtitle { font-size: 13px; color: #6b7280; }
        .badge { padding: 6px 14px; border-radius: 20px; font-size: 13px; font-weight: 600; background: #1a1f35; color: #94a3b8; }
        .badge.on { background: rgba(74, 222, 128, 0.1); color: #4ade80; }
        .badge.off { background: rgba(248, 113, 113, 0.1); color: #f87171; }
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 16px; margin-bottom: 30px; }
        .stat-card { background: #111827; padding: 20px; border-radius: 12px; text-align: center; border: 1px solid #1a1f35; }
        .stat-number { font-size: 28px; font-weight: 700; color: #60a5fa; }
        .stat-label { font-size: 13px; color: #6b7280; margin-top: 4px; }
        .status-ok { color: #4ade80; }
        .status-error { color: #f87171; }
        .info-text { color: #6b7280; font-size: 14px; margin-top: 8px; }
        footer { text-align: center; padding: 20px 0; color: #6b7280; font-size: 14px; border-top: 1px solid #1a1f35; margin-top: 30px; }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <div class="logo">
                <span class="icon">📚</span>
                <div>
                    <h1>PW Books APIs</h1>
                    <span class="subtitle">by Aryan</span>
                </div>
            </div>
            <div>
                <span class="badge <%= apiSettings.mainSwitch.is_enabled ? 'on' : 'off' %>">
                    <%= apiSettings.mainSwitch.is_enabled ? '🟢 ON' : '🔴 OFF' %>
                </span>
                <span class="badge <%= token.set ? 'on' : 'off' %>">
                    <%= token.set ? '🔑 Token Set' : '🔴 No Token' %>
                </span>
            </div>
        </header>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-number"><%= apiSettings.apiRecords.length %></div>
                <div class="stat-label">API Records</div>
            </div>
            <div class="stat-card">
                <div class="stat-number"><%= token.set ? '✅' : '❌' %></div>
                <div class="stat-label">Token Status</div>
            </div>
            <div class="stat-card">
                <div class="stat-number"><%= apiSettings.mainSwitch.is_enabled ? 'ON' : 'OFF' %></div>
                <div class="stat-label">Main Switch</div>
            </div>
            <div class="stat-card">
                <div class="stat-number"><%= new Date().toLocaleTimeString() %></div>
                <div class="stat-label">Server Time</div>
            </div>
        </div>

        <div style="background: #111827; padding: 20px; border-radius: 12px; border: 1px solid #1a1f35; margin-top: 20px;">
            <h3 style="color: #94a3b8; margin-bottom: 16px;">📋 API Status</h3>
            <p><strong>Server:</strong> PW Books APIs by Aryan</p>
            <p><strong>Status:</strong> <span class="status-ok">● Operational</span></p>
            <p><strong>Base44:</strong> <span class="status-ok">● Connected</span></p>
            <p><strong>Token:</strong> <%= token.set ? '<span class="status-ok">● Set</span>' : '<span class="status-error">● Not Set</span>' %></p>
            <p><strong>Records:</strong> <%= apiSettings.apiRecords.length %> tokens configured</p>
            <div class="info-text">
                <p>📖 <a href="/docs" style="color: #60a5fa;">View API Documentation</a></p>
                <p>🔗 Base URL: <code style="background: #0a0e1a; padding: 2px 8px; border-radius: 4px;">https://your-app.onrender.com</code></p>
            </div>
        </div>

        <footer>
            <p>PW Books APIs by Aryan &copy; 2026</p>
        </footer>
    </div>
</body>
</html>