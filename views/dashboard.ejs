<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PW Books APIs by Aryan</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: #f0f4f8;
            color: #1a202c;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .container {
            text-align: center;
            padding: 40px 20px;
        }

        /* Logo */
        .logo {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
        }

        .logo img {
            height: 60px;
            width: auto;
            object-fit: contain;
        }

        .logo h1 {
            font-size: 28px;
            font-weight: 700;
            color: #1f2937;
            letter-spacing: -0.5px;
        }

        .logo h1 .highlight {
            background: linear-gradient(135deg, #2563eb, #7c3aed);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .logo .subtitle {
            font-size: 16px;
            color: #6b7280;
            font-weight: 500;
            margin-top: -4px;
        }

        .logo .subtitle span {
            color: #2563eb;
            font-weight: 600;
        }

        /* Status Badges */
        .status-row {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-top: 24px;
            flex-wrap: wrap;
        }

        .badge {
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #ffffff;
            border: 1px solid #e5e7eb;
            color: #4b5563;
        }

        .badge .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
        }

        .badge.on {
            background: #d1fae5;
            border-color: #a7f3d0;
            color: #065f46;
        }

        .badge.on .dot {
            background: #10b981;
        }

        .badge.off {
            background: #fee2e2;
            border-color: #fca5a5;
            color: #991b1b;
        }

        .badge.off .dot {
            background: #ef4444;
        }

        .badge.token-set {
            background: #dbeafe;
            border-color: #93c5fd;
            color: #1e40af;
        }

        .badge.token-set .dot {
            background: #3b82f6;
        }

        .badge.token-empty {
            background: #fef3c7;
            border-color: #fcd34d;
            color: #92400e;
        }

        .badge.token-empty .dot {
            background: #f59e0b;
        }

        /* Footer */
        .footer {
            margin-top: 32px;
            color: #9ca3af;
            font-size: 13px;
        }

        /* Responsive */
        @media (max-width: 480px) {
            .logo h1 {
                font-size: 22px;
            }
            .logo img {
                height: 48px;
            }
            .badge {
                font-size: 12px;
                padding: 4px 12px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Logo & Title -->
        <div class="logo">
            <img src="https://images.seeklogo.com/logo-png/47/1/physics-wallah-logo-png_seeklogo-474856.png" alt="PW Logo">
            <h1>
                PW Books APIs
                <span class="highlight">by Aryan</span>
            </h1>
            <div class="subtitle">Powered by <span>Aryan</span></div>
        </div>

        <!-- Status Indicators -->
        <div class="status-row">
            <span class="badge <%= api.mainSwitch.is_enabled ? 'on' : 'off' %>">
                <span class="dot"></span>
                <%= api.mainSwitch.is_enabled ? 'Active' : 'Inactive' %>
            </span>
            <span class="badge <%= tokenSet ? 'token-set' : 'token-empty' %>">
                <span class="dot"></span>
                <%= tokenSet ? 'Token Ready' : 'No Token' %>
            </span>
        </div>

        <div class="footer">
            &copy; 2026 PW Books APIs by Aryan
        </div>
    </div>

    <script>
        // Auto-refresh every 30 seconds to update status
        setTimeout(() => {
            location.reload();
        }, 30000);
    </script>
</body>
</html>